{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "doxygen",
      "camelcase": "Doxygen",
      "title": "Doxygen",
      "scope": "source.doxygen",
      "file-types": [
      ],
      "injection-regex": "^doxygen$",
      "class-name": "TreeSitterDoxygen"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Doxygen grammar for tree-sitter",
    "authors": [
      {
        "name": "Amaan Qureshi",
        "email": "contact@amaanq.com",
        "url": "https://github.com/amaanq"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-doxygen",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
